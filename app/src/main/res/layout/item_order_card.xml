<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#1D1D21"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- User Icon -->
        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_grey">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_user"
                app:tint="#F19CBB"/>
        </FrameLayout>

        <!-- Name and Price -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iconContainer"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jane Doe"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="$150.00"
                android:textColor="#888888"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Details Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/iconContainer"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <!-- Phone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_phone"
                    app:tint="#F19CBB"/>

                <TextView
                    android:id="@+id/tvPhoneNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="+1 (555) 123-4567"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Address -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_home"
                    app:tint="#F19CBB"/>

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="123 Main St, Anytown, USA"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Items -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_box"
                    app:tint="#F19CBB"/>

                <TextView
                    android:id="@+id/tvItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Vintage armchair, blue lamp"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"
                    android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Print Button -->
        <ImageButton
            android:id="@+id/btnPrint"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_print_btn"
            android:src="@drawable/ic_printer"
            android:padding="12dp"
            android:scaleType="fitCenter"
            app:tint="#000000"/>

        <!-- Used for alignment of print button if needed to be centered relative to the whole card or bottom part -->
        <!-- In design it looks vertically centered relative to the card content or aligned to something. -->
        <!-- Actually looking at the image, the print button is aligned more towards the bottom right, maybe aligned with the details? -->
        <!-- Or maybe centered vertically in the card? -->
        <!-- In the screenshot, it looks like it's vertically centered between the top (user info) and bottom (details), or maybe just bottom right. -->
        <!-- Let's try to align it to the bottom right of the relative layout, maybe with some margin bottom. -->

    </RelativeLayout>
</androidx.cardview.widget.CardView>
