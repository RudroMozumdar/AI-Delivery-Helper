<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="16dp"
    android:background="#0F0F11">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_marginHorizontal="5dp"
        android:layout_height="64dp"
        android:background="@drawable/topbar_bg"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:gravity="center_vertical">

        <!-- App logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_logo"
            android:scaleType="fitCenter"
            android:contentDescription="App logo" />


        <!-- Settings button with PNG icon -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_settings_modern"
            android:contentDescription="Settings"
            android:background="@drawable/icon_bg"
            android:padding="8dp"
            android:scaleType="centerInside"
            app:tint="#FFFFFF" />
    </RelativeLayout>





    <!-- Text Input Area Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_marginHorizontal="5dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/card_bg">

        <EditText
            android:id="@+id/etRawText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="top|start"
            android:hint="Paste customer messages here..."
            android:textColor="#FFFFFF"
            android:textColorHint="#AFAFAF"
            android:background="@null"
            android:textSize="15sp"/>
    </LinearLayout>


    <!-- Row: Model Selector + Generate Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="5dp"
        android:gravity="center_vertical">

        <!-- Model Selector (Left) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="45dp"
            android:background="@drawable/card_bg"
            android:padding="10dp"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/spModel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>

        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <!-- Generate Orders (Right) -->
        <Button
            android:id="@+id/btnGenerate"
            android:layout_width="160dp"
            android:layout_height="45dp"
            android:text="Generate"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/btn_primary"
            android:gravity="center_vertical"
            android:drawablePadding="10dp"
            android:paddingHorizontal="12dp"
            android:drawableStart="@drawable/ic_gemini_logo"/>
    </LinearLayout>



    <!-- Row 1 Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnViewOrders"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="45dp"
            android:text="View List"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#F19CBB"
            android:background="@drawable/btn_outline"/>



        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnCreatePathaoOrders"
            android:layout_width="60dp"
            android:layout_weight="1"
            android:layout_height="45dp"
            android:text="Make Orders"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:background="@drawable/btn_primary"
            android:gravity="center_vertical"
            android:drawablePadding="30dp"
            android:paddingHorizontal="12dp"
            android:drawableStart="@drawable/ic_pathao_logo"/>

    </LinearLayout>


    <!-- Row 2 Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnSelectPrinter"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="Add Printer"
            android:textSize="13sp"
            android:textColor="#F19CBB"
            android:paddingHorizontal="9dp"
            android:background="@drawable/btn_outline"/>



        <TextView
            android:id="@+id/tvPrinter"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="7dp"
            android:text="None"
            android:textColor="#888888"
            android:gravity="center_vertical" />

        <Button
            android:id="@+id/btnPrintAll"
            android:layout_width="wrap_content"
            android:textSize="13sp"
            android:layout_height="45dp"
            android:text="Print All"
            android:paddingHorizontal="20dp"
            android:textColor="#000000"
            android:background="@drawable/btn_primary"/>
    </LinearLayout>


    <Button
        android:id="@+id/btnSaveExcel"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="Save Excel"
        android:layout_marginHorizontal="5dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#F19CBB"
        android:background="@drawable/btn_outline"
        android:layout_marginTop="12dp"/>



    <!-- Progress + Status -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginHorizontal="5dp"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_marginTop="10dp"
        android:progressTint="#F19CBB"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_marginHorizontal="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:textSize="14sp"/>

</LinearLayout>
