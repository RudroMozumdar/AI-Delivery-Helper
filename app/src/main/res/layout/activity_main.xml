<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F11"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="5dp"
        android:background="@drawable/topbar_bg"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- App logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="App logo"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_logo" />


        <!-- Settings button with PNG icon -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/icon_bg"
            android:contentDescription="Settings"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings_modern"
            app:tint="#FFFFFF" />
    </RelativeLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <EditText
                android:id="@+id/etRawText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:gravity="top|start"
                android:hint="Paste customer messages here..."
                android:padding="15dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#AFAFAF"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnPaste"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="8dp"
                android:background="@drawable/bg_circle_transparent"
                android:contentDescription="Paste"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_paste_icon"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_below="@id/btnPaste"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_transparent"
                android:contentDescription="Clear"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_clear_icon"
                app:tint="#FFFFFF" />


        </RelativeLayout>
    </LinearLayout>


    <!-- Row: Model Selector + Generate Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Model Selector (Left) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:background="@drawable/card_bg"
            android:gravity="center_vertical"
            android:padding="10dp">

            <Spinner
                android:id="@+id/spModel"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/btnGenerate"
            android:layout_width="160dp"
            android:layout_height="45dp"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_gemini_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Generate"
                android:textColor="#000000"
                android:textSize="16dp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>


    <!-- Row 1 Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnViewOrders"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:background="@drawable/btn_outline"
            android:text="View List"
            android:textAllCaps="false"
            android:textColor="#F19CBB"
            android:textSize="16sp"
            android:textStyle="bold" />


        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/btnCreatePathaoOrders"
            android:layout_width="60dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginHorizontal="3dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pathao_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Make Orders"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>


    <!-- Row 2 Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSelectPrinter"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:background="@drawable/btn_outline"
            android:paddingHorizontal="15dp"
            android:text="Add Printer"
            android:textAllCaps="false"
            android:textColor="#F19CBB"
            android:textSize="16sp" />


        <TextView
            android:id="@+id/tvPrinter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="7dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="None"
            android:textColor="#888888" />

        <Button
            android:id="@+id/btnPrintAll"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:background="@drawable/btn_primary"
            android:paddingHorizontal="20dp"
            android:text="Print All"
            android:textColor="#000000"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnSaveExcel"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/btn_outline"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginHorizontal="3dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_csv_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save CSV"
            android:textColor="#F19CBB"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- Progress + Status -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="10dp"
        android:progressTint="#F19CBB"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Ready"
        android:textColor="#AAAAAA"
        android:textSize="14sp" />

</LinearLayout>
