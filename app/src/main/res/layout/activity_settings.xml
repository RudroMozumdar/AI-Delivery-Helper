<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0F11"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gemini API Key"
                android:textColor="#F19CBB"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etGeminiKey"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:hint="Enter API Key"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:padding="10dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pathao API Credentials"
                android:textColor="#F19CBB"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etStoreId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:inputType="number"
                android:hint="Store ID (e.g. 82357)"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:padding="10dp" />

            <EditText
                android:id="@+id/etClientId"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:hint="Client ID"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:padding="10dp" />

            <EditText
                android:id="@+id/etClientSecret"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:inputType="textPassword"
                android:hint="Client Secret"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:padding="10dp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:hint="Email / Username"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:padding="10dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@null"
                android:inputType="textPassword"
                android:hint="Password"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:padding="10dp" />

            <Button
                android:id="@+id/btnFetchToken"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Fetch New Token"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#000000"
                android:background="@drawable/btn_primary"
                android:layout_marginTop="14dp"/>

            <TextView
                android:id="@+id/tvTokenStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Token Status: Unknown"
                android:textColor="#AAAAAA"
                android:gravity="center"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Printer Logo"
                android:textColor="#F19CBB"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivLogoPreview"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/ic_logo"
                    android:layout_marginEnd="14dp"/>

                <Button
                    android:id="@+id/btnSelectLogo"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Choose Image"
                    android:paddingHorizontal="15dp"
                    android:textColor="#F19CBB"
                    android:background="@drawable/btn_outline"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvLogoPath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Using Default"
                android:textColor="#AAAAAA"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Save All Settings"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_primary"/>

    </LinearLayout>

</ScrollView>