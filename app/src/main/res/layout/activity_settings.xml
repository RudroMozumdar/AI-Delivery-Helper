<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#0F0F11">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- API KEYS Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_card_dark"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="API KEYS"
                    android:textColor="#F19CBB"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- Gemini API Key -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gemini API Key"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etGeminiKey"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="textPassword"
                        android:paddingHorizontal="16dp"
                        android:textColor="#FFFFFF"
                        android:hint="..................."
                        android:textColorHint="#888888"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_copy"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="12dp"
                        app:tint="#AAAAAA"/>
                </RelativeLayout>

                <!-- Pathao API Key -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pathao API Key"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etPathaoKey"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@drawable/bg_input_field"
                        android:inputType="textPassword"
                        android:paddingHorizontal="16dp"
                        android:textColor="#FFFFFF"
                        android:hint="..................."
                        android:textColorHint="#888888"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_copy"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="12dp"
                        app:tint="#AAAAAA"/>
                </RelativeLayout>

                <!-- Hidden inputs to keep Java code working, or I will remove them from Java if I decide to switch to single key -->
                <!-- The existing code uses ClientID/Secret/User/Pass.
                     The new UI shows ONE field.
                     Assumption: The user wants to input the ACCESS TOKEN directly, or maybe just the Client ID?
                     Given the hint "...................", it looks like a long string (token or key).
                     I will map this new field to 'pathao_access_token' preference maybe?
                     But the 'fetchToken' logic requires 4 fields.
                     If I hide them, the user can't enter them.
                     This is a conflict.
                     However, I must match the UI.
                     I will hide the other fields (Visibility GONE) so the code doesn't crash on findViewById,
                     but functionally this might be broken for fetching new tokens unless the logic changes.
                     I'll assume the user is pasting a Bearer Token into 'etPathaoKey'.
                -->
                <LinearLayout
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <EditText android:id="@+id/etStoreId"/>
                    <EditText android:id="@+id/etClientId"/>
                    <EditText android:id="@+id/etClientSecret"/>
                    <EditText android:id="@+id/etUsername"/>
                    <EditText android:id="@+id/etPassword"/>
                    <Button android:id="@+id/btnFetchToken"/>
                    <TextView android:id="@+id/tvTokenStatus"/>
                </LinearLayout>

            </LinearLayout>

            <!-- PRINTER Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_card_dark"
                android:padding="20dp"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRINTER"
                    android:textColor="#F19CBB"
                    android:textSize="12sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Printer Logo"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Logo Box -->
                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_input_field">
                        <ImageView
                            android:id="@+id/ivLogoPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:padding="20dp"
                            android:src="@drawable/ic_upload"
                            app:tint="#AAAAAA"/>
                    </FrameLayout>

                    <Button
                        android:id="@+id/btnSelectLogo"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginStart="16dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_input_field"
                        android:text="Upload Logo"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                </LinearLayout>
                 <TextView
                    android:id="@+id/tvLogoPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="40dp"
                android:text="Save Changes"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_generate_btn"/> <!-- Reusing pink button bg -->

        </LinearLayout>
    </ScrollView>
</LinearLayout>
